# Copy this file to .env and adjust values for your local setup.

# ==== LLM (Ollama) ====
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2:3b
# Tried in order if OLLAMA_MODEL isn't pulled on the server.
OLLAMA_FALLBACK_MODELS=llama3.1,mistral,llama3
# CPU-only inference of a full prompt can take 150-370s even with a small 3B
# model -- a shorter timeout guarantees every attempt fails identically.
OLLAMA_TIMEOUT_SECONDS=450
OLLAMA_MAX_RETRIES=2
OLLAMA_RETRY_BACKOFF_SECONDS=2.0
OLLAMA_TEMPERATURE=0.2

# ==== LLM prompt construction ====
LLM_PROMPT_MAX_ITEMS_PER_SECTION=10

# ==== Embeddings ====
# Provider used to embed log events / incident text for FAISS.
EMBEDDING_PROVIDER=sentence-transformers
EMBEDDING_MODEL_NAME=BAAI/bge-small-en-v1.5
EMBEDDING_DIMENSION=384

# ==== FAISS vector store ====
FAISS_INDEX_DIR=data/faiss_index
FAISS_INDEX_NAME=incidents.index

# ==== Data paths ====
LOG_INPUT_DIR=data/logs
KNOWLEDGE_BASE_DIR=data/knowledge_base
REPORTS_OUTPUT_DIR=reports

# ==== Message categorization (app.analysis.message_catalog) ====
# Point this at a different file to adapt category inference to another
# log source without touching code. See config/message_categories.json.
MESSAGE_CATEGORY_CONFIG_PATH=config/message_categories.json

# ==== Error grouping (app.analysis.error_grouping) ====
ERROR_GROUPING_SEVERITIES=WARNING,ERROR,CRITICAL
ERROR_GROUPING_SAMPLE_SIZE=3
ERROR_GROUPING_NORMALIZE_DYNAMIC_CONTENT=true

# ==== Component analysis (app.analysis.component_analysis) ====
COMPONENT_FAILURE_SEVERITIES=ERROR,CRITICAL
COMPONENT_DEGRADED_THRESHOLD=0.05
COMPONENT_CRITICAL_THRESHOLD=0.15

# ==== Severity analysis ====
SEVERITY_TOP_N=10

# ==== Correlation / failure detection ====
CORRELATION_WINDOW_SECONDS=30
CORRELATION_CANDIDATE_SEVERITIES=WARNING,ERROR,CRITICAL
CORRELATION_MIN_MATCHING_DIMENSIONS=2
CORRELATION_CONFIDENCE_BASE=0.3
CORRELATION_CONFIDENCE_PER_DIMENSION=0.2
CORRELATION_CONFIDENCE_CORROBORATION_BONUS_MAX=0.1
CORRELATION_CONFIDENCE_CORROBORATION_PER_EVENT=0.02

REPEATED_FAILURE_THRESHOLD=3
REPEATED_FAILURE_WINDOW_MINUTES=15

# ==== Timeline ====
RECOVERY_WINDOW_SECONDS=120
TIMELINE_RECOVERY_SEVERITY=INFO
TIMELINE_MIN_RECOVERY_CONFIDENCE=0.5
TIMELINE_MIN_RECOVERY_CLUSTER_SIZE=3

# ==== Statistics ====
STATISTICS_TOP_N=5

# ==== RAG ====
RAG_TOP_K=5

# ==== Logging ====
LOG_LEVEL=INFO
LOG_FILE=logs/app.log
